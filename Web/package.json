{
  "name": "stackdock-web",
  "private": true,
  "version": "4.0.6",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prerender": "tsx scripts/prerender.ts",
    "build:site": "vite build",
    "build:preview": "vite build --config vite.preview.config.ts && tsx scripts/finalize-preview.ts",
    "build": "npm run typecheck && npm run prerender && npm run build:site && npm run build:preview",
    "dev": "npm run prerender && vite"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
