# StackDock web · nginx (Coolify). Las variables ${...} las sustituye la imagen oficial de nginx al arrancar.
# CF-IPCountry solo llega si el DNS de Cloudflare está en modo proxy (nube naranja).

# Cookie de idioma elegida por el usuario (stackdock-lang=en|es, 1 año)
map $http_cookie $sd_lang_cookie {
    default "";
    "~*(?:^|;\s*)stackdock-lang=(?<sdlang>en|es)(?:;|$)" $sdlang;
}

# Países hispanohablantes → /es/ en la primera visita
map $http_cf_ipcountry $sd_geo_es {
    default 0;
    MX 1; ES 1; AR 1; CO 1; PE 1; CL 1; VE 1; EC 1; GT 1; CU 1; BO 1;
    DO 1; HN 1; PY 1; SV 1; NI 1; CR 1; PA 1; UY 1; PR 1; GQ 1;
}

# Nunca redirigir buscadores ni generadores de vista previa
map $http_user_agent $sd_is_bot {
    default 0;
    "~*(bot|crawl|spider|slurp|bingpreview|facebookexternalhit|embedly|quora|pinterest|vkshare|whatsapp|telegram|discord|slack|skype|lighthouse|headless|preview|validator)" 1;
}

# cookie:geo:bot → 1 = redirigir a /es/
map "$sd_lang_cookie:$sd_geo_es:$sd_is_bot" $sd_to_es {
    default 0;
    "~^es:[01]:0$" 1;   # eligió español antes
    "~^:1:0$"      1;   # sin cookie y país hispanohablante
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;
    resolver ${NGINX_RESOLVER} valid=300s ipv6=off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self' https:; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location = /api/health {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"ok":true,"app":"stackdock","service":"web","version":"4.0.6"}';
    }

    # Checkout → Payment Gateway Universal (n8n). POST { plan, addFindaro, locale, customerEmail? } → { url }
    location = /api/checkout {
        limit_except POST { deny all; }
        set $checkout_upstream "${CHECKOUT_UPSTREAM}";
        proxy_pass $checkout_upstream;
        proxy_ssl_server_name on;
        proxy_set_header Content-Type "application/json";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        add_header Cache-Control "no-store" always;
    }

    # Home EN con geolocalización (302 privado, nunca cacheado)
    location = / {
        add_header Vary "Cookie, CF-IPCountry" always;
        add_header Cache-Control "private, no-cache" always;
        if ($sd_to_es) { return 302 /es/; }
        try_files /index.html =404;
    }
    location = /index.html { return 301 /; }
    location = /es { return 301 /es/; }
    location /es/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /es/index.html;
    }

    # Assets con hash de Vite
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location /media/ {
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    # Instaladores firmados
    location /download/ {
        types { application/x-apple-diskimage dmg; }
        default_type application/octet-stream;
        add_header Content-Disposition "attachment" always;
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri =404;
    }

    # Feed firmado del actualizador de la app (no cachear)
    location /updates/ {
        default_type application/json;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /index.html;
}
