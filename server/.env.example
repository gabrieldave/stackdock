# StackDock · backend (Node 22 + PostgreSQL 17)
# Copia este archivo a `.env` en la raíz del repo (Coolify lo inyecta con env_file).
# NUNCA subas el .env real al repositorio.

# ── Servidor ───────────────────────────────────────────────────────────
PORT=8080
PUBLIC_DIR=/app/public
STORAGE_DIR=/app/storage
PUBLIC_URL=https://stackdock.iareal.net
NODE_ENV=production

# ── PostgreSQL 17 ─────────────────────────────────────────────────────
# postgres://usuario:password@host:5432/stackdock
DATABASE_URL=
# auto | disable | require | verify-full
DATABASE_SSL=auto

# ── n8n (Payment Gateway Universal + trial onboarding) ────────────────
N8N_PAYMENT_WEBHOOK=https://n8n.vibesystems.tech/webhook/payment
N8N_TRIAL_WEBHOOK=https://n8n.vibesystems.tech/webhook/stackdock-trial

# ── Stripe (solo verificación de firma; no se usa SDK) ────────────────
STRIPE_WEBHOOK_SECRET=

# ── Licencias Ed25519 ─────────────────────────────────────────────────
# 32 bytes en base64 (seed) o PEM PKCS#8 de una línea con \n escapados.
LICENSE_PRIVATE_KEY=

# ── Resend (entrega de licencias) ─────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=stackdock@iareal.net

# ── Google OAuth (panel /admin, authorization code server-side) ───────
GOOGLE_CLIENT_ID=1091222021847-ph8k6rbvkpkk9gf1j41v6hiiqje6vnlc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Lista separada por comas
ADMIN_ALLOWED_EMAILS=david.del.rio.colin@gmail.com

# ── Sesiones / estado OAuth ───────────────────────────────────────────
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=
